{
  "supabase": {
    "auth_providers": {
      "email": {
        "enabled": true,
        "email_confirm_required": true,
        "email_confirm_timeout": 86400
      },
      "password": {
        "enabled": true,
        "min_length": 8,
        "require_uppercase": true,
        "require_lowercase": true,
        "require_digit": true,
        "require_special_char": true
      }
    },
    "session": {
      "jwt_expiry": 3600,
      "refresh_token_expiry": 2592000,
      "session_timeout": 86400,
      "max_sessions_per_user": 5
    },
    "security": {
      "max_login_attempts": 5,
      "lockout_duration": 900,
      "password_history_count": 5,
      "password_expiry_days": 90,
      "two_factor_auth": false
    }
  },
  "email": {
    "templates": {
      "confirmation": {
        "subject": "【練習表自動生成システム】メールアドレスの確認",
        "template_path": "app/templates/emails/confirmation.html"
      },
      "password_reset": {
        "subject": "【練習表自動生成システム】パスワードリセット",
        "template_path": "app/templates/emails/reset_password.html"
      }
    },
    "sender": {
      "name": "練習表自動生成システム",
      "email": "noreply@tomosigoto-nou.com"
    }
  },
  "redis": {
    "host": "localhost",
    "port": 6379,
    "db": 0,
    "password": null,
    "session_prefix": "session:",
    "user_sessions_prefix": "user_sessions:"
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "auth_events": true,
    "security_events": true
  }
}