# Secret = 環境変数の機密情報を安全に扱う仕組み
# docker-compose の .env ファイルに相当するが、base64エンコードして保存する
#
# 使い方:
#   1. このファイルをコピー: cp secret.yaml.example secret.yaml
#   2. 値を base64 エンコードして設定:
#      echo -n "mypassword" | base64
#   3. kubectl apply -f secret.yaml
#
# ⚠️  secret.yaml は .gitignore に追加すること！

apiVersion: v1
kind: Secret
metadata:
  name: tomosigoto-secret
  namespace: tomosigoto
type: Opaque
data:
  # echo -n "your_value" | base64 でエンコードした値を入れる
  POSTGRES_USER: cG9zdGdyZXM=         # postgres
  POSTGRES_PASSWORD: cGFzc3dvcmQ=     # password (必ず変える)
  POSTGRES_DB: dG9tb3NpZ290bw==       # tomosigoto
  SECRET_KEY: eW91ci1zZWNyZXQta2V5   # JWTの署名キー (必ず変える)
