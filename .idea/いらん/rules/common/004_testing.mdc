### 3. 非同期処理のテスト

```typescript
import { renderHook } from '@testing-library/react-hooks';
import { useAsync } from './useAsync';

describe('useAsync', () => {
  it('非同期処理が正しく実行されること', async () => {
    const mockFn = jest.fn().mockResolvedValue('success');
    const { result, waitForNextUpdate } = renderHook(() => useAsync(mockFn));

    expect(result.current.loading).toBe(true);
    expect(result.current.error).toBe(null);
    expect(result.current.data).toBe(null);

    await waitForNextUpdate();

    expect(result.current.loading).toBe(false);
    expect(result.current.error).toBe(null);
    expect(result.current.data).toBe('success');
  });

  it('エラーが正しく処理されること', async () => {
    const mockError = new Error('test error');
    const mockFn = jest.fn().mockRejectedValue(mockError);
    const { result, waitForNextUpdate } = renderHook(() => useAsync(mockFn));

    await waitForNextUpdate();

    expect(result.current.loading).toBe(false);
    expect(result.current.error).toBe(mockError);
    expect(result.current.data).toBe(null);
  });
});
```

## テストのベストプラクティス

### 1. テストの独立性

- 各テストは独立して実行可能であること
- テスト間で状態を共有しないこと
- テストの実行順序に依存しないこと

### 2. テストの可読性

- テストの目的が明確であること
- テストケースの名前が分かりやすいこと
- テストコードに適切なコメントを付けること

### 3. テストの保守性

- テストコードの重複を避けること
- テストヘルパー関数を適切に使用すること
- テストデータの管理を適切に行うこと

### 4. テストの実行速度

- 不要なテストを実行しないこと
- モックを適切に使用すること
- 並列実行を活用すること

## テスト環境の設定

### 1. Jest設定（jest.config.js）

```javascript
module.exports = {
  preset: 'ts-jest',
  testEnvironment: 'node',
  roots: ['<rootDir>/src'],
  transform: {
    '^.+\\.tsx?$': 'ts-jest',
  },
  testRegex: '(/__tests__/.*|(\\.|/)(test|spec))\\.tsx?$',
  moduleFileExtensions: ['ts', 'tsx', 'js', 'jsx', 'json', 'node'],
  setupFilesAfterEnv: ['<rootDir>/src/test/setup.ts'],
  collectCoverageFrom: [
    'src/**/*.{ts,tsx}',
    '!src/**/*.d.ts',
    '!src/test/**/*',
  ],
  coverageThreshold: {
    global: {
      branches: 70,
      functions: 90,
      lines: 80,
      statements: 80,
    },
  },
};
```

### 2. テストセットアップ（setup.ts）

```typescript
import '@testing-library/jest-dom';
import { configure } from '@testing-library/react';

// テストのタイムアウト設定
configure({ asyncUtilTimeout: 5000 });

// グローバルなモックの設定
global.console = {
  ...console,
  error: jest.fn(),
  warn: jest.fn(),
};

// テスト環境のクリーンアップ
afterEach(() => {
  jest.clearAllMocks();
});
```

### 3. テストヘルパー（test-utils.tsx）

```typescript
import React from 'react';
import { render as rtlRender } from '@testing-library/react';
import { Provider } from 'react-redux';
import { configureStore } from '@reduxjs/toolkit';
import { rootReducer } from '../store';

function render(
  ui: React.ReactElement,
  {
    preloadedState,
    store = configureStore({ reducer: rootReducer, preloadedState }),
    ...renderOptions
  } = {}
) {
  function Wrapper({ children }: { children: React.ReactNode }) {
    return <Provider store={store}>{children}</Provider>;
  }
  return rtlRender(ui, { wrapper: Wrapper, ...renderOptions });
}

export * from '@testing-library/react';
export { render };
```

## テストの自動化

### 1. CI/CD設定（.github/workflows/test.yml）

```yaml
name: Test

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  test:
    runs-on: ubuntu-latest

    strategy:
      matrix:
        node-version: [16.x, 18.x]

    steps:
    - uses: actions/checkout@v2
    
    - name: Use Node.js ${{ matrix.node-version }}
      uses: actions/setup-node@v2
      with:
        node-version: ${{ matrix.node-version }}
        
    - name: Install dependencies
      run: npm ci
      
    - name: Run tests
      run: npm test
      
    - name: Upload coverage
      uses: codecov/codecov-action@v2
      with:
        token: ${{ secrets.CODECOV_TOKEN }}
```

### 2. テストスクリプト（package.json）

```json
{
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:ci": "jest --ci --coverage --runInBand"
  }
}
```

