# Environment Configuration
ENVIRONMENT=development
NODE_ENV=development
DEVELOPMENT_MOUNT=rw

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=***REMOVED***
SUPABASE_SERVICE_ROLE_KEY=***REMOVED***

# Database Configuration
SUPABASE_DATABASE_URL=***REMOVED***

# Backend Configuration
SECRET_KEY=development-secret-key-for-jwt-tokens-change-in-production
API_BASE_URL=http://localhost:8000
API_V1_STR=/api/v1

# JWT Configuration
JWT_SECRET_KEY=development-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_SECRET=dev-access-token-secret-change-in-production
ACCESS_TOKEN_EXPIRES_IN=15m
LOGIN_TOKEN_SECRET=dev-login-token-secret-change-in-production
LOGIN_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=dev-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRES_IN=90d

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=***REMOVED***
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=***REMOVED***

# Application Settings
PROJECT_NAME=Tomosigoto API
DEBUG=False
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Debug Configuration
DEBUG_MODE=true
DEMO_MODE=false
TELEMETRY_ENABLED=false
TELEMETRY_ANONYMIZATION_ENABLED=true

# Frontend Auth Callback
FRONT_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Google Auth (Optional)
AUTH_GOOGLE_ENABLED=false
# AUTH_GOOGLE_CLIENT_ID=your_google_client_id
# AUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
# AUTH_GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/redirect

# Storage Configuration
STORAGE_TYPE=local

# Production Example (uncomment for production):
# ENVIRONMENT=production
# NODE_ENV=production
# SECRET_KEY=your-super-secure-production-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key
# NEXT_PUBLIC_API_URL=https://your-domain.com

# データベース設定（必要に応じて）
DATABASE_URL=postgresql://user:password@localhost/dbname 