.PHONY: build up down logs sh init-db reset-db test-users test-users-unit test-users-integration

# コンテナのビルド
build:
	docker-compose build

# コンテナの起動
up:
	docker-compose up -d

# デタッチモードなしでコンテナを起動（ログが見れる）
up-logs:
	docker-compose up

# コンテナの停止
down:
	docker-compose down

# コンテナ群のログを表示
logs:
	docker-compose logs -f

# サーバーのシェルに入る
sh-server:
	docker-compose exec twenty-server sh

# フロントエンドのシェルに入る
sh-front:
	docker-compose exec twenty-front sh

# データベースの初期化（マイグレーションとシードデータ投入）
init-db:
	docker-compose exec twenty-server yarn prisma:migrate
	docker-compose exec twenty-server yarn prisma:seed

# データベースのリセット
reset-db:
	docker-compose exec twenty-server yarn prisma:reset

# 全てのサービスをクリーンに起動する（ボリュームも削除）
clean:
	docker-compose down -v
	docker-compose build
	docker-compose up -d
	@echo "データベースが起動するまで10秒待機します..."
	@sleep 10
	$(MAKE) init-db
	@echo "セットアップが完了しました！"
	@echo "フロントエンド: http://localhost:3000"
	@echo "バックエンドAPI: http://localhost:3001/graphql"
	@echo "ドキュメント: http://localhost:5001"

# ===== ユーザーCRUD操作テスト =====

# ユーザー関連の全テストを実行
test-users: test-users-unit test-users-integration
	@echo "✅ ユーザーCRUD操作テスト完了"

# ユーザー関連のユニットテストを実行
test-users-unit:
	@echo "🧪 ユーザーCRUD操作ユニットテスト実行中..."
	@cd backend && python3 -m pytest tests/unit/api/endpoints/test_users.py -v

# ユーザー関連の統合テストを実行（実際のSupabaseトークン使用）
test-users-integration:
	@echo "🔧 ユーザーCRUD操作統合テスト実行中..."
	@cd backend && python3 tests/integration_test_users_with_supabase.py

# バックエンドコンテナ内でテストを実行
test-users-docker:
	@echo "🐳 Dockerコンテナ内でユーザーCRUD操作テスト実行中..."
	@docker compose exec backend python3 -m pytest tests/unit/api/endpoints/test_users.py -v
	@docker compose exec backend python3 tests/integration_test_users_with_supabase.py

# バックエンドの全テストを実行
test-backend:
	@echo "🧪 バックエンド全テスト実行中..."
	@cd backend && python3 -m pytest tests/ -v

# バックエンドの全テストをDockerコンテナ内で実行
test-backend-docker:
	@echo "🐳 Dockerコンテナ内でバックエンド全テスト実行中..."
	@docker compose exec backend python3 -m pytest tests/ -v 