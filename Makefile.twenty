.PHONY: build up down logs sh init-db reset-db

# コンテナのビルド
build:
	docker-compose build

# コンテナの起動
up:
	docker-compose up -d

# デタッチモードなしでコンテナを起動（ログが見れる）
up-logs:
	docker-compose up

# コンテナの停止
down:
	docker-compose down

# コンテナ群のログを表示
logs:
	docker-compose logs -f

# サーバーのシェルに入る
sh-server:
	docker-compose exec twenty-server sh

# フロントエンドのシェルに入る
sh-front:
	docker-compose exec twenty-front sh

# データベースの初期化（マイグレーションとシードデータ投入）
init-db:
	docker-compose exec twenty-server yarn prisma:migrate
	docker-compose exec twenty-server yarn prisma:seed

# データベースのリセット
reset-db:
	docker-compose exec twenty-server yarn prisma:reset

# 全てのサービスをクリーンに起動する（ボリュームも削除）
clean:
	docker-compose down -v
	docker-compose build
	docker-compose up -d
	@echo "データベースが起動するまで10秒待機します..."
	@sleep 10
	$(MAKE) init-db
	@echo "セットアップが完了しました！"
	@echo "フロントエンド: http://localhost:3000"
	@echo "バックエンドAPI: http://localhost:3001/graphql"
	@echo "ドキュメント: http://localhost:5001" 