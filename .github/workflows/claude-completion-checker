name: Claude Completion Checker
on:
  schedule:
    # メインのワークフローの15分後に実行（JST 23:15-06:15の間、30分ごと）
    - cron: '15,45 14-20 * * *'  # UTC 14:15-20:45 (JST 23:15-05:45)
    - cron: '15 21 * * *'        # UTC 21:15 (JST 06:15)
  workflow_dispatch: # 手動実行も可能

jobs:
  check-completion:
    runs-on: ubuntu-latest
    
    steps:
      - name: Check Claude processing status
        uses: actions/github-script@v7
        with:
          github-token: ${{ secrets.PERSONAL_ACCESS_TOKEN }}
          script: |
            const processedLabel = 'claude-code-requested';
            const completedLabel = 'claude-completed';
            const maxRetries = 3; // 最大リトライ回数
            
            // 処理中のissueを取得（claude-code-requestedラベルがあり、claude-completedラベルがない）
            const issues = await github.rest.issues.listForRepo({
              owner: context.repo.owner,
              repo: context.repo.repo,
              labels: processedLabel,
              state: 'open',
              per_page: 100
            });
            
            // claude-completedラベルがないissueをフィルタ
            const processingIssues = issues.data.filter(issue => 
              !issue.labels.some(label => label.name === completedLabel)
            );
            
            for (const issue of processingIssues) {
              // issueのコメントを取得
              const comments = await github.rest.issues.listComments({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: issue.number,
                per_page: 100
              });
              
              // @claudeメンションのコメントを探す
              const claudeMentions = comments.data.filter(comment => 
                comment.body.includes('@claude')
              );
              
              if (claudeMentions.length === 0) continue;
              
              // 最後の@claudeメンションの時間を取得
              const lastMention = claudeMentions[claudeMentions.length - 1];
              const lastMentionTime = new Date(lastMention.created_at);
              const now = new Date();
              const timeDiff = (now - lastMentionTime) / 1000 / 60; // 分単位
              
              // 10分以上経過していて、Claudeからの応答がない場合
              if (timeDiff > 10) {
                // Claudeからの応答をチェック（botユーザーまたは特定のパターンを含むコメント）
                const hasClaudeResponse = comments.data.some(comment => {
                  const isAfterMention = new Date(comment.created_at) > lastMentionTime;
                  const looksLikeClaudeResponse = 
                    comment.body.includes('実装方針') || 
                    comment.body.includes('コード変更') ||
                    comment.body.includes('提案') ||
                    comment.body.includes('解決策') ||
                    comment.user.type === 'Bot';
                  return isAfterMention && looksLikeClaudeResponse;
                });
                
                // チェックボックスの状態を確認
                const checkboxes = issue.body ? issue.body.match(/- \[[ x]\]/gi) || [] : [];
                const uncheckedBoxes = issue.body ? issue.body.match(/- \[ \]/gi) || [] : [];
                const hasUncheckedBoxes = uncheckedBoxes.length > 0;
                const checkboxStatus = checkboxes.length > 0 ? 
                  `(チェックボックス: ${checkboxes.length - uncheckedBoxes.length}/${checkboxes.length} 完了)` : '';
                
                // 関連するPRがあるかチェック
                const prs = await github.rest.pulls.list({
                  owner: context.repo.owner,
                  repo: context.repo.repo,
                  state: 'open',
                  per_page: 100
                });
                
                const relatedPR = prs.data.find(pr => 
                  pr.body && pr.body.includes(`#${issue.number}`)
                );
                
                // 完了判定: Claudeの応答があり、PRがあるか、チェックボックスが全て完了
                const isCompleted = (hasClaudeResponse || relatedPR) && !hasUncheckedBoxes;
                
                if (!isCompleted) {
                  // リトライ回数をチェック
                  const retryComments = comments.data.filter(comment => 
                    comment.body.includes('まだ処理が完了していないようです')
                  );
                  
                  if (retryComments.length < maxRetries) {
                    // 続行を促すコメントを投稿
                    await github.rest.issues.createComment({
                      owner: context.repo.owner,
                      repo: context.repo.repo,
                      issue_number: issue.number,
                      body: [
                        `@claude まだ処理が完了していないようです。`,
                        '',
                        `Issue #${issue.number} の解決を続けてください。`,
                        '',
                        hasUncheckedBoxes ? `**未完了のタスクがあります** ${checkboxStatus}` : '',
                        '',
                        '以下の点を確認してください：',
                        '- 実装方針の提案',
                        '- 必要なコード変更の詳細',
                        '- PRの作成（必要に応じて）',
                        hasUncheckedBoxes ? '- チェックボックスのタスクの完了' : '',
                        '',
                        `リトライ ${retryComments.length + 1}/${maxRetries}`
                      ].join('\n')
                    });
                    
                    console.log(`Retried issue #${issue.number} (retry ${retryComments.length + 1})`);
                  } else {
                    // 最大リトライ回数に達した場合
                    await github.rest.issues.createComment({
                      owner: context.repo.owner,
                      repo: context.repo.repo,
                      issue_number: issue.number,
                      body: [
                        '⚠️ Claude Codeによる自動処理が完了しませんでした。',
                        '',
                        '手動での対応が必要です。',
                        `最大リトライ回数（${maxRetries}回）に達しました。`,
                        '',
                        hasUncheckedBoxes ? `未完了のタスク: ${checkboxStatus}` : ''
                      ].join('\n')
                    });
                    
                    // エラーラベルを追加
                    await github.rest.issues.addLabels({
                      owner: context.repo.owner,
                      repo: context.repo.repo,
                      issue_number: issue.number,
                      labels: ['claude-error']
                    });
                    
                    console.log(`Max retries reached for issue #${issue.number}`);
                  }
                } else if (isCompleted) {
                  // 処理が完了している場合（Claudeの応答/PRがあり、かつチェックボックスが全て完了）
                  await github.rest.issues.addLabels({
                    owner: context.repo.owner,
                    repo: context.repo.repo,
                    issue_number: issue.number,
                    labels: [completedLabel]
                  });
                  
                  console.log(`Issue #${issue.number} marked as completed ${checkboxStatus}`);
                }
              }
            }
            
            console.log('Completion check finished');
